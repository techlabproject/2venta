{
  "name": "2venta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker && npm run build:demo",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/worker.cjs --external:pg-native --log-level=warning",
    "worker": "tsx src/worker/index.ts",
    "demo": "node --env-file=.env.local --import tsx db/demo.mts",
    "build:demo": "esbuild db/demo.mts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/demo.cjs --external:pg-native --log-level=warning",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db minio elasticmq && docker compose run --rm minio-init",
    "db:seed": "tsx db/seed.ts",
    "test:e2e": "playwright test",
    "verify": "tsc --noEmit && eslint && npm run test:unit && npm run db:seed && playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:unit": "node --env-file=.env.local --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "tsx db/migrate.mts"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "better-auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
